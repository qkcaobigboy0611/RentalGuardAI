<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.rental.guard.ai.infrastructure.mapper.MessageMapper">
    <resultMap id="BaseResultMap" type="com.rental.guard.ai.infrastructure.po.PoMessage">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="channel_id" property="channelId" jdbcType="INTEGER"/>
        <result column="creator_id" property="creatorId" jdbcType="VARCHAR"/>
        <result column="type" property="type" jdbcType="INTEGER"/>
        <result column="payload" property="payload" jdbcType="VARCHAR"/>
        <result column="offset" property="offset" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>


    </resultMap>
    <sql id="Base_Column_List">
        id
        , channel_id, creator_id, type, payload, offset,create_time
    </sql>
    <select id="selectByChannelAndOffset" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM message
        WHERE channel_id = #{channelId}
        AND offset BETWEEN #{from} AND #{to}
    </select>

</mapper>
